{
  "name": "brizo-logistics",
  "private": true,
  "scripts": {
    "start": "node apps/api-subastas/index.js",
    "start:subastas": "node apps/api-subastas/index.js",
    "start:aduanas": "node apps/api-aduanas/index.js",
    "start:frontend": "node apps/frontend/server.js",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.8",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
